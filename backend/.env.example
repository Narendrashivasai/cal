# Server Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Authentication
JWT_SECRET=your-super-secret-jwt-key-here

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/cali
# OR for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/cali

# External APIs
GOOGLE_VISION_API_KEY=your-google-vision-api-key
CLARIFAI_API_KEY=your-clarifai-api-key
USDA_API_KEY=your-usda-api-key
EDAMAM_APP_ID=your-edamam-app-id
EDAMAM_APP_KEY=your-edamam-app-key

# OpenAI API for meal planning
OPENAI_API_KEY=your-openai-api-key

# Logging
LOG_LEVEL=info

# Firebase Admin (for production authentication)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email